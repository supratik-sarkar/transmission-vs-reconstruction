# PUBLIC TEMPLATE. Never place a real credential in this repository.
# Copy this file into your private runtime workspace and fill it there.

# Runtime workspace for data, runs, caches and credentials.
# Must be OUTSIDE this repository and must not be a Git repository.
HANDOFF_PRIVATE_HOME=

# Providers. Default to the deterministic mock; no network call is made.
HANDOFF_RELAY_PROVIDER=mock
HANDOFF_RECEIVER_PROVIDER=mock

# Exact pinned version strings. UNFROZEN is a hard error at run time, by design:
# a moving alias would make measurement claims unreproducible.
HANDOFF_RELAY_MODEL=UNFROZEN
HANDOFF_RECEIVER_MODEL=UNFROZEN

# Frozen protocol values.
HANDOFF_TOKENIZER=cl100k_base
HANDOFF_SOURCE_WINDOW_TOKENS=2000
HANDOFF_RELAY_BUDGET_TOKENS=500
HANDOFF_K_FOCAL=3
HANDOFF_MASTER_SEED=20260907
HANDOFF_DECODER_REGIME=D

# Off by default. No network access occurs during tests or CI.
HANDOFF_ALLOW_NETWORK=false

# Credentials are read from the environment only and are never logged.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# Descriptive user agent required by some data providers.
SOURCE_USER_AGENT=
